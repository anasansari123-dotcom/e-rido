EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key
EXPO_PUBLIC_API_URL=https://e-rido.onrender.com

# Android-restricted Maps SDK key. Set locally in .env.local (gitignored).
# For cloud builds, also set it in the matching EAS environment (preview + production).
# Never use EXPO_PUBLIC_ for this key or reuse it for web/server APIs.
# Google Cloud checklist for blank maps:
# 1) Enable "Maps SDK for Android"
# 2) Enable billing on the project
# 3) Restrict the key to Android apps with package com.mohdanas786.eride
# 4) Add the EAS upload keystore SHA-1 (expo.dev → credentials → Android)
# 5) Rebuild APK after changing the key: npx eas-cli build -p android --profile preview
# Expo Go cannot show your project Google Maps key — install the APK.
GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-key

# Optional. iOS-restricted key (Maps SDK for iOS). Without it iOS shows Apple Maps.
GOOGLE_MAPS_IOS_API_KEY=your-ios-maps-key
