PORT=3000

# Same Supabase project as the Expo app. Use placeholders here.
# The mobile app reads EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_KEY
# from its own .env.local. Do not put a service-role key in the Expo app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. Server only. Never commit the real value and never ship it in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Server key restricted to Places API (New) + Routes API. Never expose this in the Expo app.
GOOGLE_MAPS_SERVER_API_KEY=your-server-maps-key
