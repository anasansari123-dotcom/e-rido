{
  "expo": {
    "name": "MTUK Nagar Ride",
    "slug": "e-ride",
    "scheme": "eride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohdanas786.eride"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mohdanas786.eride"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "baa99b96-fdfe-4f7e-908f-206d81c8aa27"
      }
    }
  }
}
